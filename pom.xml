<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Parent: Spring Boot 4.1.0 (latest GA per Maven Central metadata, 2026-08-17).
      The parent imports the spring-boot-dependencies BOM, which governs the versions
      of Flyway, the PostgreSQL driver, Testcontainers, Jackson, and Spring Framework.
      We therefore declare those dependencies WITHOUT explicit versions. Only springdoc
      (not managed by the BOM) is pinned. Rationale + sources: docs/decisions/0001-technology-versions.md
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.raghavendra</groupId>
    <artifactId>audit-log-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>audit-log-service</name>
    <description>Tamper-evident audit log service (interview assignment) — scaffolding stage</description>

    <properties>
        <!-- Java 21 is within Spring Boot 4.1's supported range (17–26). -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Only dependency NOT managed by the Spring Boot BOM; pinned per ADR 0001. -->
        <springdoc.version>3.1.0</springdoc.version>

        <!--
          Testcontainers: the Spring Boot 4.1.0 parent defines a testcontainers.version
          property (2.0.5) but does NOT import the testcontainers-bom into a child
          project's dependencyManagement. We therefore import that BOM ourselves below,
          pinned to the SAME version the Spring Boot BOM uses (2.0.5, verified from the
          spring-boot-dependencies BOM — see ADR 0001), so the Testcontainers modules
          resolve a managed, Spring-Boot-aligned version.
        -->
        <testcontainers.version>2.0.5</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ===== Web / API ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ===== Persistence (JPA) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ===== Request validation (Bean Validation) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== Security (API-key filter to be added in a later step) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ===== PostgreSQL driver (version managed by Spring Boot BOM = 42.7.11) ===== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Flyway migrations (versions managed by Spring Boot BOM = 12.4.0) =====
             NOTE: Spring Boot 4.x moved Flyway AUTO-CONFIGURATION out of
             spring-boot-autoconfigure into the dedicated `spring-boot-flyway` module.
             Without it, flyway-core is on the classpath but Flyway never runs at startup.
             See ADR 0002. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <!-- Required for PostgreSQL support in Flyway 10+ (managed at ${flyway.version} by the BOM). -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ===== OpenAPI / Swagger UI (springdoc 3.1.0 — the Spring Boot 4.x line; pinned) ===== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ===== Test ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Spring Boot 4.x split the web-mvc test slice (MockMvc / MockMvcTester,
                 @AutoConfigureMockMvc) into this dedicated module. See ADR 0004. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!--
              Testcontainers PostgreSQL module. NOTE: Testcontainers 2.x RENAMED the
              module coordinates from `org.testcontainers:postgresql` (1.x) to
              `org.testcontainers:testcontainers-postgresql` (2.x). Version managed by the
              imported testcontainers-bom (2.0.5). See ADR 0001.
            -->
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Spring Boot ↔ Testcontainers integration (@ServiceConnection etc.). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
