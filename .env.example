# =============================================================================
# EXAMPLE environment file for local development. Copy to .env and adjust:
#
#     cp .env.example .env
#
# The real .env is GIT-IGNORED (see .gitignore). This .example file is committed
# and contains ONLY non-secret, LOCAL-ONLY development defaults. Do NOT put real
# passwords, API keys, or private keys here.
#
# docker compose automatically reads .env for the variables referenced in
# docker-compose.yml (the POSTGRES_* group below).
#
# IMPORTANT: docker compose reading .env configures the CONTAINER only. These
# variables are NOT automatically exported into a separately launched Maven/JVM
# process. To make `./mvnw spring-boot:run` use them, export them in your shell
# (e.g. `set -a; source .env; set +a` on bash) or put the values in a git-ignored
# application-local.yml. The AUDIT_* group below documents the values to keep in sync.
# =============================================================================

# ---- PostgreSQL (consumed by docker-compose.yml) ----
# NOTE: POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD are honored by the postgres
# image ONLY when it initializes a NEW, EMPTY data volume (first `up`). Changing them
# later does NOT re-provision an existing volume — you must recreate the volume
# (`docker compose down -v`) for new init values to take effect.
POSTGRES_DB=audit
POSTGRES_USER=audit
# LOCAL-ONLY development password. Change it for your machine if you like; if you do,
# also update AUDIT_DB_PASSWORD below (and any application-local.yml) to match.
POSTGRES_PASSWORD=audit_local_dev
POSTGRES_PORT=5432

# ---- Application datasource (read by application.yml ONLY if these vars are exported
#      into the app's process — see note above; not auto-exported by docker compose) ----
AUDIT_DB_URL=jdbc:postgresql://localhost:5432/audit
AUDIT_DB_USERNAME=audit
AUDIT_DB_PASSWORD=audit_local_dev
AUDIT_SERVER_PORT=8080
